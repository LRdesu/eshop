// eshop 模拟电商平台 - ER 可视化文件 (dbdiagram.io 格式)
// 用法: 打开 https://dbdiagram.io  -> Import  -> 粘贴本文件，或拖入 .er 文件即可生成关系图
// 说明: 支付环节用 orders 表状态字段模拟，未单独建 payments 表

Table users {
  id int [pk, increment]
  username varchar(50) [not null, unique]
  password_hash varchar(100) [not null]
  phone varchar(20)
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table addresses {
  id int [pk, increment]
  user_id int [not null]
  receiver varchar(50) [not null]
  phone varchar(20) [not null]
  province varchar(50)
  city varchar(50)
  detail varchar(200) [not null]
  is_default tinyint [default: 0]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table products {
  id int [pk, increment]
  name varchar(100) [not null]
  description text
  category varchar(50)
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table skus {
  id int [pk, increment]
  product_id int [not null]
  spec varchar(100) [not null]
  price decimal(10,2) [not null]
  stock int [not null, default: 0]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table cart_items {
  id int [pk, increment]
  user_id int [not null]
  sku_id int [not null]
  quantity int [not null, default: 1]
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table orders {
  id int [pk, increment]
  order_no varchar(32) [not null, unique]
  user_id int [not null]
  address_id int [not null]
  total_amount decimal(10,2) [not null]
  shipping_fee decimal(10,2) [not null, default: 0]
  pay_status tinyint [default: 0, note: '0未付 1已付']
  order_status tinyint [default: 0, note: '0待付款 1待发货 2已发货 3已完成 4已取消']
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table order_items {
  id int [pk, increment]
  order_id int [not null]
  sku_id int [not null]
  quantity int [not null]
  price decimal(10,2) [not null]
}

Table shipments {
  id int [pk, increment]
  order_id int [not null, unique]
  carrier varchar(50)
  tracking_no varchar(50)
  ship_status tinyint [default: 0, note: '0待发货 1已揽收 2运输中 3已签收']
  shipped_at datetime
  created_at datetime [default: `CURRENT_TIMESTAMP`]
}

Table shipping_fees {
  id int [pk, increment]
  region varchar(50) [not null, unique]
  fee decimal(10,2) [not null]
}

Ref: addresses.user_id > users.id
Ref: skus.product_id > products.id
Ref: cart_items.user_id > users.id
Ref: cart_items.sku_id > skus.id
Ref: orders.user_id > users.id
Ref: orders.address_id > addresses.id
Ref: order_items.order_id > orders.id
Ref: order_items.sku_id > skus.id
Ref: shipments.order_id > orders.id
